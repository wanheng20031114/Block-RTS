[gd_resource type="Resource" script_class="DefenseScenarioDefinition" load_steps=13 format=3]

[ext_resource type="Script" path="res://scripts/defense/defense_scenario_definition.gd" id="scenario"]
[ext_resource type="Script" path="res://scripts/defense/defense_wave_definition.gd" id="wave"]


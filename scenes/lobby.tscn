[sub_resource type="Shader" id="Scrim"]
code = "shader_type canvas_item;
void fragment() {
 float side = smoothstep(0.26,0.81,UV.x);
 float edge = smoothstep(0.45,0.98,abs(UV.y-0.50)*2.0);
 COLOR = vec4(vec3(0.10,0.18,0.17),clamp(mix(0.97,0.05,side)+edge*0.12,0.0,0.98));
}"


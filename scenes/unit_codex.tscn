[sub_resource type="ButtonGroup" id="PreviewActionGroup"]
resource_local_to_scene = true

[sub_resource type="ButtonGroup" id="Grades"]

[node name="UnitCodex" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

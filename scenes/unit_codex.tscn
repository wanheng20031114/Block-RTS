CheckButton/styles/hover = ExtResource("medieval_selection")
CheckButton/styles/pressed = ExtResource("medieval_selection")
CheckButton/styles/hover_pressed = ExtResource("medieval_selection")

[sub_resource type="Environment" id="Environment"]
background_mode = 1
background_color = Color(0.063, 0.056, 0.043, 1)
ambient_light_source = 2
